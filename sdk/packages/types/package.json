{
  "name": "@hefaos/types",
  "version": "0.1.0",
  "description": "Hefaos Types - Shared TypeScript type definitions",
  "keywords": ["robotics", "types", "typescript", "hefaos"],
  "license": "MIT",
  "author": "Hefaos Robotics",
  "repository": {
    "type": "git",
    "url": "https://github.com/hefaos-robotics/hefaos.git",
    "directory": "sdk/packages/types"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
