{
  "name": "@hefaos/cli",
  "version": "0.1.0",
  "description": "Hefaos CLI - Development tools for Hefaos robotics projects",
  "keywords": ["robotics", "cli", "devtools", "hefaos"],
  "license": "MIT",
  "author": "Hefaos Robotics",
  "repository": {
    "type": "git",
    "url": "https://github.com/hefaos-robotics/hefaos.git",
    "directory": "sdk/packages/cli"
  },
  "type": "module",
  "bin": {
    "hefaos": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hefaos/compiler": "workspace:*",
    "@hefaos/sdk": "workspace:*",
    "@hefaos/types": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "prompts": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/prompts": "^2.4.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
