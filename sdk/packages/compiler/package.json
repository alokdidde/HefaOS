{
  "name": "@hefaos/compiler",
  "version": "0.1.0",
  "description": "Hefaos Compiler - TSX to C++ code generator",
  "keywords": ["robotics", "compiler", "codegen", "typescript", "cpp"],
  "license": "MIT",
  "author": "Hefaos Robotics",
  "repository": {
    "type": "git",
    "url": "https://github.com/hefaos-robotics/hefaos.git",
    "directory": "sdk/packages/compiler"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hefaos/types": "workspace:*",
    "@hefaos/schemas": "workspace:*",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "vitest": "^1.3.0"
  }
}
